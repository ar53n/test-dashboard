# Скопируйте в .env и при необходимости измените. Все переменные необязательны.
# .env читают docker compose и `npm run dev` (сервер целиком, Vite — только SERVER_PORT).

# Порт nginx на хосте (docker compose): http://localhost:8080
CLIENT_PORT=8080
# Адрес, на котором compose публикует порт. По умолчанию только эта машина;
# 0.0.0.0 открывает приложение в сеть (включённый AI тогда тратит ключ по запросам любых клиентов).
CLIENT_BIND=127.0.0.1

# Порт API-сервера. В dev-режиме его читают и сервер, и прокси Vite
SERVER_PORT=3001

# Интервал между изменениями данных симулятора, мс
SIM_MIN_INTERVAL_MS=1500
SIM_MAX_INTERVAL_MS=4000

# Максимум одновременных WebSocket-клиентов на сервере; сверх него upgrade получает 503.
# В демо ограничения нет. Для публичного размещения раскомментируйте здесь и в
# docker-compose.yml, а лимит на один IP включите в nginx/default.conf.template.
# LIVE_MAX_CLIENTS=200

# AI-поиск: любой OpenAI-совместимый API с поддержкой response_format json_schema.
# Без AI_API_KEY и AI_MODEL AI-поиск выключен, работает поиск по названию.
# Ключ используется только сервером и в клиентскую сборку не попадает.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Ожидание ответа провайдера. Больше 25000 не имеет смысла: nginx отдаёт клиенту 504
# через 30 с, поэтому сервер ограничивает значение сверху.
AI_TIMEOUT_MS=20000
# Общие для всех клиентов лимиты запросов к провайдеру; сверх них сервер отвечает 429.
# nginx дополнительно ограничивает AI-поиск 10 запросами в минуту с одного IP.
AI_MAX_CONCURRENT=4
AI_RATE_LIMIT_PER_MINUTE=30
